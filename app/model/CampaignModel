<?php

namespace App\Model;

class CampaignModel {
    private int $id;
    private String $nomeCampanha;
    private String $senhaCampanha;
    private int $idMestre;

    public function __construct(array $data) {
        $this->id = $data['id'];
        $this->nomeCampanha = $data['nomeCampanha'];
        $this->senhaCampanha = $data['senhaCampanha'];
        $this->idMestre = $data['idMestre'];
    }
}

